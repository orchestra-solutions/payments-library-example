# Orchestra API Configuration
# Copy this file to .env and fill in your values

# Your Orchestra API key (required)
# Generate one at: https://portal.orchestrasolutions.com/#/apikey/create
# Don't have an account? Sign up free: https://portal.orchestrasolutions.com/#/register
ORCHESTRA_API_KEY=

# Orchestra API base URL
ORCHESTRA_API_URL=https://api.orchestrasolutions.com

# Mode: TEST or LIVE
# Use TEST for sandbox/testing, LIVE for production
MODE=TEST

# =============================================================================
# Payment Gateway Account (required for card payments)
# =============================================================================
# The name you assigned to your gateway in Orchestra Portal > Resources > Payment Gateway Accounts
# For testing, use the NULLSuccess mock gateway (e.g. test-success)
PAYMENT_GATEWAY_ACCOUNT_ID=

# =============================================================================
# eWallet Accounts (configure the payment methods you want to support)
# =============================================================================
# The name you assigned to each account in Orchestra Portal > Resources > eWallet Accounts
# Each payment method requires its own eWallet account
# For testing, configure a CardPay eWallet account pointing to your mock gateway

# Card Pay account ID (for credit/debit card payments)
EWALLET_CARDPAY_ACCOUNT_ID=

# Google Pay account ID
EWALLET_GOOGLEPAY_ACCOUNT_ID=

# Apple Pay account ID
EWALLET_APPLEPAY_ACCOUNT_ID=

# PayPal account ID
EWALLET_PAYPAL_ACCOUNT_ID=

# Bank Pay (Open Banking/ACH) account ID
EWALLET_BANKPAY_ACCOUNT_ID=

# UPI account ID
EWALLET_UPI_ACCOUNT_ID=

# =============================================================================
# Server Configuration
# =============================================================================
PORT=3000
