# =============================================================================
# Orchestra Payments Library — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Don't have an account? Sign up free (no credit card required):
#   https://portal.orchestrasolutions.com/#/register
# =============================================================================


# =============================================================================
# API Key (required)
# =============================================================================
# Your Orchestra API key, used to authenticate every request to the API.
#
# How to get it:
#   1. Log in to the Orchestra Portal: https://portal.orchestrasolutions.com
#   2. Click API Keys in the left sidebar → Create
#   3. Give it a name and click Save
#   4. Copy the key immediately — it is only shown once
#
# Direct link: https://portal.orchestrasolutions.com/#/apikey/create
ORCHESTRA_API_KEY=


# =============================================================================
# API Base URL (optional)
# =============================================================================
# The Orchestra API endpoint. Leave as default unless instructed otherwise.
ORCHESTRA_API_URL=https://api.orchestrasolutions.com


# =============================================================================
# Mode (optional)
# =============================================================================
# TEST  — uses mock/sandbox gateways, no real money moves
# LIVE  — uses production gateways, real transactions
MODE=TEST


# =============================================================================
# Payment Gateway Account (required)
# =============================================================================
# The name you assigned to a Payment Gateway Account in the portal.
# This is NOT a system-generated ID — it is the name you chose when creating it.
#
# How to get it:
#   1. Portal → Resources (sidebar) → Payment Gateway Account → Create
#   2. Enter a name (e.g. test-success) and select a provider
#   3. Use that same name here
#
# For sandbox testing, create a gateway with the NULLSuccess provider.
# NULLSuccess always approves. NULLFailure always declines (useful for error testing).
#
# Direct link: https://portal.orchestrasolutions.com/#/resource/paymentGateway/create
PAYMENT_GATEWAY_ACCOUNT_ID=


# =============================================================================
# eWallet Accounts
# =============================================================================
# Each payment method (CardPay, Google Pay, etc.) requires its own eWallet account
# configured in the portal. The value is the name you assigned to that account —
# NOT a system-generated ID.
#
# How to create one:
#   1. Portal → Resources (sidebar) → eWallet Accounts → Create
#   2. Select the payment method type and fill in the required credentials
#   3. Use that account name here
#
# Direct link: https://portal.orchestrasolutions.com/#/resource/eWalletAccount/create
#
# Leave any unused payment methods blank — they will be disabled automatically.
# =============================================================================

# CardPay — credit and debit card payments (required for basic testing)
# Create a CardPay eWallet account and link it to your Payment Gateway Account above.
EWALLET_CARDPAY_ACCOUNT_ID=

# Google Pay — available in Chrome and Android browsers
# Requires Google Pay merchant credentials from Google.
EWALLET_GOOGLEPAY_ACCOUNT_ID=

# Apple Pay — available in Safari on iOS and macOS
# Requires Apple Pay merchant credentials and domain verification.
EWALLET_APPLEPAY_ACCOUNT_ID=

# PayPal — available in all browsers
# Requires a PayPal merchant account and API credentials.
EWALLET_PAYPAL_ACCOUNT_ID=

# Bank Pay — Open Banking (EU) and ACH (US) bank transfers
# Requires an Open Banking or ACH provider account.
EWALLET_BANKPAY_ACCOUNT_ID=

# UPI — Unified Payments Interface (India)
# Requires a UPI provider account.
EWALLET_UPI_ACCOUNT_ID=


# =============================================================================
# Server (optional)
# =============================================================================
PORT=3000
